{
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "final"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "questions"],
        "properties": {
          "name": { "type": "string" },
          "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
        }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "hint", "entry"],
      "properties": {
        "category": { "type": "string" },
        "hint": { "type": "string" },
        "entry": { "$ref": "#/$defs/question" }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer", "sourceId", "imageAlt", "pressPhotoAlt"],
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "sourceId": { "type": "string" },
        "imageAlt": { "type": "string" },
        "pressPhotoAlt": { "type": "string" }
      }
    }
  }
}
